# Server
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/talkitout

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Browser origins allowed by the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-2.0-flash
ALLOW_EXTERNAL_PII=false

# Singapore crisis resources
CRISIS_EMERGENCY=999
CRISIS_SOS_LINE=1767
CRISIS_SOS_TEXT=9151 1767

# ElevenLabs (optional; omit the key to disable voice features)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_LATENCY=2
ELEVENLABS_TTS_FORMAT=audio/mpeg
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=eleven_multilingual_v2
MAX_STT_SECONDS=60
