{
  "name": "talkitout",
  "version": "1.0.0",
  "description": "AI-powered support system for Singapore students",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@talkitout/web",
    "dev:web": "npm run dev --workspace=@talkitout/web",
    "build": "npm run build --workspace=@talkitout/web",
    "preview": "npm run preview --workspace=@talkitout/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
